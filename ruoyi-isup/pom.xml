<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ruoyi</groupId>
        <artifactId>ruoyi</artifactId>
        <version>3.8.9</version>
    </parent>

    <artifactId>ruoyi-isup</artifactId>
    <description>海康 ISUP 设备接入（开源骨架版：仅保留 domain/constants/接口与空实现，不含海康 SDK 与原生库，勿用闭源版整体覆盖）</description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 通用工具 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-common</artifactId>
        </dependency>

        <!-- 系统模块 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-system</artifactId>
        </dependency>

        <!-- 流媒体模块 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-wvp</artifactId>
        </dependency>

        <!-- 媒体节点模块（ZLM 节点/收流参数等领域对象已拆分到 ruoyi-media） -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-media</artifactId>
        </dependency>

        <!-- ONVIF 模块，复用 wvp_device 实体 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-onvif</artifactId>
        </dependency>

        <!-- 统一报警模块（ISUP 报警写入 wvp_alarms） -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-alarms</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 海康 ISUP SDK 所需 JNA（结构体已统一继承 HIKSDKStructure，版本由根 pom 的 jna.version 管理） -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
        </dependency>

        <!-- JAXB (Java 8 兼容版本) -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>2.3.1</version>
        </dependency>

        <!-- velocity 模板，用于动态生成 XML -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <includeSystemScope>true</includeSystemScope>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
