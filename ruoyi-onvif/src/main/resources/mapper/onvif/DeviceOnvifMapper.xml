    <sql id="selectDeviceOnvifVo">
        select id, dept_id, device_id, name, manufacturer, db_model, firmware, transport, stream_mode, on_line, register_time, keepalive_time, ip, create_time, update_time, port, expires, subscribe_cycle_for_catalog, subscribe_cycle_for_mobile_position, mobile_position_submission_interval, subscribe_cycle_for_alarm, host_address, charset, ssrc_check, geo_coord_sys, media_server_id, custom_name, sdp_ip, local_ip, password, as_message_channel, heart_beat_interval, heart_beat_count, position_capability, broadcast_push_after_ack, lat, lng, address_map, protocol_type, src_url, stream_type, ffmpeg_cmd_key, rtsp_type, enable_audio, enable_mp4, enable_remove_none_reader, enable_disable_none_reader, stream_key, start_offline_push, pushing, push_time, user_name, onvif_auth_type from wvp_device
    </sql>

    <select id="selectDeviceOnvifList" parameterType="DeviceOnvif" resultMap="DeviceOnvifResult">
        <include refid="selectDeviceOnvifVo"/>
        <where>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="deviceId != null  and deviceId != ''"> and device_id = #{deviceId}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="manufacturer != null  and manufacturer != ''"> and manufacturer = #{manufacturer}</if>
            <if test="dbModel != null  and dbModel != ''"> and db_model = #{dbModel}</if>
            <if test="firmware != null  and firmware != ''"> and firmware = #{firmware}</if>
            <if test="transport != null  and transport != ''"> and transport = #{transport}</if>
            <if test="streamMode != null  and streamMode != ''"> and stream_mode = #{streamMode}</if>
            <if test="onLine != null "> and on_line = #{onLine}</if>
            <if test="registerTime != null  and registerTime != ''"> and register_time = #{registerTime}</if>
            <if test="keepaliveTime != null  and keepaliveTime != ''"> and keepalive_time = #{keepaliveTime}</if>
            <if test="ip != null  and ip != ''"> and ip = #{ip}</if>
            <if test="port != null "> and port = #{port}</if>
            <if test="expires != null "> and expires = #{expires}</if>
            <if test="subscribeCycleForCatalog != null "> and subscribe_cycle_for_catalog = #{subscribeCycleForCatalog}</if>
            <if test="subscribeCycleForMobilePosition != null "> and subscribe_cycle_for_mobile_position = #{subscribeCycleForMobilePosition}</if>
            <if test="mobilePositionSubmissionInterval != null "> and mobile_position_submission_interval = #{mobilePositionSubmissionInterval}</if>
            <if test="subscribeCycleForAlarm != null "> and subscribe_cycle_for_alarm = #{subscribeCycleForAlarm}</if>
            <if test="hostAddress != null  and hostAddress != ''"> and host_address = #{hostAddress}</if>
            <if test="charset != null  and charset != ''"> and charset = #{charset}</if>
            <if test="ssrcCheck != null "> and ssrc_check = #{ssrcCheck}</if>
            <if test="geoCoordSys != null  and geoCoordSys != ''"> and geo_coord_sys = #{geoCoordSys}</if>
            <if test="mediaServerId != null  and mediaServerId != ''"> and media_server_id = #{mediaServerId}</if>
            <if test="customName != null  and customName != ''"> and custom_name like concat('%', #{customName}, '%')</if>
            <if test="sdpIp != null  and sdpIp != ''"> and sdp_ip = #{sdpIp}</if>
            <if test="localIp != null  and localIp != ''"> and local_ip = #{localIp}</if>
            <if test="password != null  and password != ''"> and password = #{password}</if>
            <if test="asMessageChannel != null "> and as_message_channel = #{asMessageChannel}</if>
            <if test="heartBeatInterval != null "> and heart_beat_interval = #{heartBeatInterval}</if>
            <if test="heartBeatCount != null "> and heart_beat_count = #{heartBeatCount}</if>
            <if test="positionCapability != null "> and position_capability = #{positionCapability}</if>
            <if test="broadcastPushAfterAck != null "> and broadcast_push_after_ack = #{broadcastPushAfterAck}</if>
            <if test="lat != null  and lat != ''"> and lat = #{lat}</if>
            <if test="lng != null  and lng != ''"> and lng = #{lng}</if>
            <if test="addressMap != null  and addressMap != ''"> and address_map = #{addressMap}</if>
            <if test="protocolType != null  and protocolType != ''"> and protocol_type = #{protocolType}</if>
            <if test="srcUrl != null  and srcUrl != ''"> and src_url = #{srcUrl}</if>
            <if test="streamType != null  and streamType != ''"> and stream_type = #{streamType}</if>
            <if test="ffmpegCmdKey != null  and ffmpegCmdKey != ''"> and ffmpeg_cmd_key = #{ffmpegCmdKey}</if>
            <if test="rtspType != null  and rtspType != ''"> and rtsp_type = #{rtspType}</if>
            <if test="enableAudio != null "> and enable_audio = #{enableAudio}</if>
            <if test="enableMp4 != null "> and enable_mp4 = #{enableMp4}</if>
            <if test="enableRemoveNoneReader != null "> and enable_remove_none_reader = #{enableRemoveNoneReader}</if>
            <if test="enableDisableNoneReader != null "> and enable_disable_none_reader = #{enableDisableNoneReader}</if>
            <if test="streamKey != null  and streamKey != ''"> and stream_key = #{streamKey}</if>
            <if test="startOfflinePush != null "> and start_offline_push = #{startOfflinePush}</if>
            <if test="pushing != null "> and pushing = #{pushing}</if>
            <if test="pushTime != null  and pushTime != ''"> and push_time = #{pushTime}</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="onvifAuthType != null  and onvifAuthType != ''"> and onvif_auth_type = #{onvifAuthType}</if>
        </where>
    </select>


    <select id="selectAllDeviceList" parameterType="DeviceReqVo" resultMap="DeviceOnvifResult">
        SELECT de.*,
        (SELECT COUNT(0) FROM wvp_device_channel dc WHERE dc.data_device_id = de.id) AS channel_count
        FROM wvp_device de
        <where>
            <if test="protocolType != null  and protocolType != ''"> and protocol_type = #{protocolType}</if>
            <if test='key != null and key != ""'>
                AND (de.name LIKE CONCAT('%', #{key}, '%') OR de.device_id LIKE CONCAT('%', #{key}, '%'))
            </if>
            <if test='status != null'>
                AND de.on_line = #{status}
            </if>
            <if test="manufacturer != null  and manufacturer != ''"> and manufacturer = #{manufacturer}</if>
        </where>
        ORDER BY de.create_time DESC
    </select>

    <select id="selectAllDeviceListFiltered" resultMap="DeviceOnvifResult">
        SELECT de.*,
        (SELECT COUNT(0) FROM wvp_device_channel dc WHERE dc.data_device_id = de.id) AS channel_count
        FROM wvp_device de
        <where>
            <if test="reqVo.protocolType != null  and reqVo.protocolType != ''"> and protocol_type = #{reqVo.protocolType}</if>
            <if test='reqVo.key != null and reqVo.key != ""'>
                AND (de.name LIKE CONCAT('%', #{reqVo.key}, '%') OR de.device_id LIKE CONCAT('%', #{reqVo.key}, '%'))
            </if>
            <if test='reqVo.status != null'>
                AND de.on_line = #{reqVo.status}
            </if>
            <if test="reqVo.manufacturer != null  and reqVo.manufacturer != ''"> and manufacturer = #{reqVo.manufacturer}</if>
            <if test="deviceIds != null and deviceIds.size() > 0">
                AND de.device_id IN
                <foreach collection="deviceIds" item="deviceId" open="(" separator="," close=")">
                    #{deviceId}
                </foreach>
            </if>
        </where>
        ORDER BY de.create_time DESC
    </select>

    <select id="selectDeviceOnvifListHasChannelCount" parameterType="DeviceOnvif" resultMap="DeviceOnvifResult">
        SELECT de.*,
        (SELECT COUNT(0) FROM wvp_device_channel dc WHERE dc.data_device_id = de.id) AS channel_count
        FROM wvp_device de
        WHERE de.protocol_type='ONVIF'
        <if test='name != null and name != ""'>
            AND (de.name LIKE CONCAT('%', #{name}, '%') OR de.device_id LIKE CONCAT('%', #{name}, '%'))
        </if>
        <if test='onLine != null'>
            AND de.on_line = #{onLine}
        </if>
        ORDER BY de.create_time DESC
    </select>

    <!-- 探测任务：查询需要探测的ONVIF设备 -->
    <!-- 时间阈值在Java层预计算后传入，兼容MySQL/SQLite/达梦三种数据库 -->
    <select id="selectOnvifDevicesForProbe" resultMap="DeviceOnvifResult">
        SELECT de.*,
        (SELECT COUNT(0) FROM wvp_device_channel dc WHERE dc.data_device_id = de.id) AS channel_count
        FROM wvp_device de WHERE de.protocol_type = 'ONVIF'
        AND (
          (de.keepalive_time IS NULL OR de.keepalive_time = '')
          OR (de.on_line = 1 AND de.keepalive_time &lt;= #{heartbeatThreshold})
          OR (de.on_line = 0 AND de.keepalive_time &lt;= #{offlineThreshold})
        )
        ORDER BY de.create_time DESC
    </select>

    <!-- 探测任务：仅更新 keepalive + online -->
    <update id="updateDeviceOnvifProbe" parameterType="DeviceOnvif">
        UPDATE wvp_device SET
            keepalive_time = #{keepaliveTime},
            on_line = #{onLine}
        WHERE id = #{id}
    </update>
</mapper>
