    <select id="selectDeviceChannelList" parameterType="DeviceChannelReqVo" resultMap="DeviceOnvifChannelResult">
        <include refid="selectDeviceOnvifChannelVo"/>
        <where>
            <if test='key != null and key != ""'>
                AND (name LIKE CONCAT('%', #{key}, '%') OR device_id LIKE CONCAT('%', #{key}, '%'))
            </if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="parentId != null  and parentId != ''"> and parent_id = #{parentId}</if>
            <if test="dataType != null "> and data_type = #{dataType}</if>
            <if test="dataDeviceId != null "> and data_device_id = #{dataDeviceId}</if>
            <if test="filterGps != null and filterGps == true">
                and longitude is not null and latitude is not null and longitude != 0 and latitude != 0
            </if>
        </where>
    </select>


    <delete id="deleteDeviceOnvifChannelByDataDeviceId" parameterType="Long">
        delete from wvp_device_channel where data_device_id = #{dataDeviceId}
    </delete>

    <!-- 探测任务：按 dataDeviceId 批量更新通道状态 -->
    <update id="updateStatusByDataDeviceId">
